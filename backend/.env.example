# Neuralab Production & Sandbox Environment Configuration
PORT=5504
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# PayPal Integration (Mandatory Environment Separation)
# Set PAYPAL_ENV to "sandbox" for development/testing, or "live" for production
PAYPAL_ENV=sandbox

# Official PayPal Sandbox REST API Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_key_here

# PayPal Webhook ID (from PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=

# Admin Master Passphrase (No hardcoded fallback allowed)
ADMIN_SECRET_KEY=
